# Copy this file to .env and fill in real values. Never commit .env to git.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=UTC

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=studyflow

# JWT (falls back to SECRET_KEY if empty)
JWT_SECRET=change-me-to-another-long-random-string
JWT_EXPIRY_MINUTES=10080

# CORS (comma-separated list of allowed frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI (optional - the app works fully without it)
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
